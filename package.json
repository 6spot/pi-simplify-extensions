{
	"name": "pi-simplify-extensions",
	"version": "1.0.8",
	"license": "MIT",
	"description": "Personal lightweight Pi TUI: collapsible tools, rich diffs, and Codex-style editor",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"claude-code"
	],
	"homepage": "https://github.com/6spot/pi-simplify-extensions#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/6spot/pi-simplify-extensions.git"
	},
	"bugs": {
		"url": "https://github.com/6spot/pi-simplify-extensions/issues"
	},
	"files": [
		"extensions",
		"themes",
		"simplify.json",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"themes": [
			"./themes/simplify-dark.json",
			"./themes/simplify-light.json"
		]
	},
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"coverage": "node --test --experimental-test-coverage --test-coverage-include=extensions/**/*.ts tests/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome check ."
	},
	"dependencies": {
		"@shikijs/cli": "^4.0.2",
		"jiti": "^2.7.0"
	},
	"bundledDependencies": [],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"typescript": "^5.9.3"
	}
}
